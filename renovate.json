{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Australia/Brisbane",
  "schedule": ["before 6am"],
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "matchPackageNames": ["@usero/sdk", "rrweb", "rrweb-player"],
      "groupName": "usero widget",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    }
  ]
}
